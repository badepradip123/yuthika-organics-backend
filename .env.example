NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# PostgreSQL
DATABASE_URL=postgresql://yuthika:yuthika_dev_password@localhost:5432/yuthika_organics?schema=public

# Frontends (comma separated)
WEB_APP_URL=http://localhost:5173
ADMIN_APP_URL=http://localhost:5174

# JWT
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-long-random-secret-at-least-32-characters
JWT_REFRESH_EXPIRES_IN=30d

# Initial admin for seed (set only for initial bootstrap, then rotate/remove)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-this-immediately

# Swagger
ENABLE_SWAGGER=true
SWAGGER_PATH=docs

# Razorpay (optional until payment gateway is enabled)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shipping
SHIPPING_FLAT_RATE=0
FREE_SHIPPING_THRESHOLD=999
COD_ENABLED=true

# Production platform can set these
TRUST_PROXY=1
